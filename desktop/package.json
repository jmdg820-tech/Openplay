{
  "name": "openplay-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "OpenPlay Windows desktop shell (Electron, hosting the OpenPlay Flutter Web build).",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:web": "node ../scripts/build-flutter-web.mjs",
    "pack:desktop": "npm run build:web && electron-builder --win dir --publish never",
    "build:desktop": "npm run build:web && node ../scripts/build-desktop-win.mjs",
    "test": "node --test \"electron/**/*.test.cjs\""
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "app.openplay.desktop",
    "productName": "OpenPlay",
    "copyright": "OpenPlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "webapp/**/*",
      "resources/icon.ico",
      "package.json"
    ],
    "electronVersion": "38.8.6",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "icon": "resources/icon.ico",
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenPlay-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OpenPlay"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jmdg820-tech",
        "repo": "Openplay"
      }
    ]
  }
}
